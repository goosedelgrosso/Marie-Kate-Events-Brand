# Copy to .env.local for local development, and set the same values in
# Vercel under Settings > Environment Variables for deployed builds.

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where inquiries are delivered. Comma-separate for more than one recipient.
INQUIRY_TO=

# Optional. Defaults to onboarding@resend.dev, which only delivers to the
# Resend account owner. Set this to an address on a domain verified in
# Resend (e.g. inquiries@mariekateevents.com) to send to anyone.
INQUIRY_FROM=
